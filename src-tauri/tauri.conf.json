{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix Play",
  "version": "0.5.4",
  "identifier": "com.matrix.frontend",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Matrix Play",
        "width": 1360,
        "height": 850,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#0c1019"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "Game",
    "shortDescription": "Console, Steam and Windows game libraries for Linux",
    "linux": {
      "deb": {
        "conflicts": [
          "matrix"
        ],
        "replaces": [
          "matrix"
        ],
        "provides": [
          "matrix"
        ]
      }
    }
  }
}
