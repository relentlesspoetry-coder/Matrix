{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix Play",
  "version": "0.6.10",
  "identifier": "com.matrix.frontend",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "cargo build --locked --release --manifest-path src-tauri/Cargo.toml --no-default-features --bin matrix-install-update --bin matrix-update-coordinator",
    "beforeBuildCommand": "cargo build --locked --release --manifest-path src-tauri/Cargo.toml --no-default-features --bin matrix-install-update --bin matrix-update-coordinator"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Matrix-Play",
        "width": 1360,
        "height": 850,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#cee4f7"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob: https://cdn2.steamgriddb.com https://cdn.steamgriddb.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "Game",
    "shortDescription": "Console, Steam and Windows game libraries for Linux",
    "linux": {
      "deb": {
        "depends": [
          "pkexec"
        ],
        "conflicts": [
          "matrix"
        ],
        "replaces": [
          "matrix"
        ],
        "provides": [
          "matrix"
        ],
        "files": {
          "/usr/lib/matrix-play/matrix-install-update": "target/release/matrix-install-update"
        },
        "postInstallScript": "debian/postinst.sh"
      }
    },
    "resources": {
      "target/release/matrix-update-coordinator": "matrix-update-coordinator"
    }
  }
}
